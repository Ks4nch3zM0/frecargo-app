{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FRECARGO · MySQL local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "django": true,
      "justMyCode": true
    },
    {
      "name": "FRECARGO · Demo local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload", "--settings=config.settings_demo"],
      "django": true,
      "justMyCode": true
    }
  ]
}
