# scripts/init_env.py genera una clave aleatoria para tu .env local.
DJANGO_SECRET_KEY=GENERAR_CON_scripts_init_env_py
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_ENGINE=mysql
DB_NAME=frecargo
DB_USER=frecargo_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Para una base remota, consulta los certificados de tu proveedor.
# DB_SSL_CA=/ruta/al/certificado-ca.pem
# Habilitar solo detrás de un proxy propio que sanee X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
